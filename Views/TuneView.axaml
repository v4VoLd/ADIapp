<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="800"
             x:Class="ADIapp.Views.TuneView"
             DragDrop.AllowDrop="True">

    <!-- ================= THEME ACCENT OVERRIDES ================= -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#4DFF8A"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnHover" Color="#66FF9E"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#33EE77"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#4DFF8A"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnHover" Color="#66FF9E"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#33EE77"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0F172A"/>
        <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#4DFF8A"/>
    </UserControl.Resources>

    <!-- ================= TOGGLE & BUTTON STYLES ================= -->
    <UserControl.Styles>
        <!-- Toggle OFF -->
        <Style Selector="ToggleSwitch /template/ Border#PART_Track">
            <Setter Property="Background" Value="#22242D"/>
            <Setter Property="BorderBrush" Value="#383C4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <!-- Toggle ON (Emerald Green) -->
        <Style Selector="ToggleSwitch:checked /template/ Border#PART_Track">
            <Setter Property="Background" Value="#4DFF8A"/>
            <Setter Property="BorderBrush" Value="#4DFF8A"/>
        </Style>
        <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#PART_Track">
            <Setter Property="Background" Value="#66FF9E"/>
            <Setter Property="BorderBrush" Value="#66FF9E"/>
        </Style>

        <!-- Toggle thumb -->
        <Style Selector="ToggleSwitch /template/ Border#PART_Thumb">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <!-- Action Buttons Hover -->
        <Style Selector="Button.action-btn">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- TITLE / HEADER WITH BACK BUTTON & DAILY QUOTA -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="30,20,280,10">

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="14"
                        VerticalAlignment="Center">

                <!-- BACK BUTTON -->
                <Button x:Name="BackButton"
                        Click="Back_Click"
                        Content="← Back"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#CFCFCF"
                        Background="#242430"
                        Padding="14,8"
                        CornerRadius="10"
                        Margin="0,0,8,0"
                        Cursor="Hand"/>

                <Border Width="40"
                        Height="40"
                        CornerRadius="10"
                        Background="#242430"
                        BorderBrush="#383C4A"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        Padding="4">
                    <Image x:Name="BrandLogoImage"
                           Source="avares://ADIapp/Assets/sidebar_logo.png"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="VehicleTitleText"
                               Text="Vehicle &amp; ECU Information"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock x:Name="VehicleSubtitleText"
                               Text="Upload a binary file or select an active task to inspect specifications."
                               FontSize="12"
                               Foreground="#9E9EA0"/>
                </StackPanel>
            </StackPanel>

            <!-- DAILY QUOTA BADGE (COMMENTED OUT)
            <Border Grid.Column="1"
                    Background="#18181A"
                    BorderBrush="#2A2D3A"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="30"
                            Height="30"
                            CornerRadius="8"
                            Background="#24242A"
                            VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TuneDailyQuotaTitleText"
                                   Text="Daily Quota"
                                   FontSize="10"
                                   Foreground="#9E9EA0"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="TuneDailyQuotaValueText"
                                   Text="Unlimited"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#4DFF8A"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            -->
        </Grid>

        <!-- MAIN CARD -->
        <Border Grid.Row="1"
                Margin="30,10,30,30"
                Padding="24,20"
                CornerRadius="22"
                Background="#1C1C1C"
                Opacity="0.95"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- TOP DETAILS SECTION (VEHICLE, ENGINE, ECU CARDS) -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="300" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto">
                        
                        <!-- VEHICLE SPECS CARD -->
                        <Border Grid.Column="0" Margin="4" Padding="12,10" Background="#141414" CornerRadius="14" BorderBrush="#262832" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="VehSpecsTitleText" Text="VEHICLE SPECS" FontSize="11" Foreground="#4DFF8A" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto" Margin="0,2,0,0">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                                        <TextBlock x:Name="LblProducerText" Text="PRODUCER" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="VehProducerText" Text="-" FontSize="12" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,4">
                                        <TextBlock x:Name="LblModelText" Text="MODEL" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="VehModelText" Text="-" FontSize="12" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock x:Name="LblYearChassisText" Text="YEAR / CHASSIS" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="VehYearChassisText" Text="-" FontSize="11" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock x:Name="LblBuildTypeText" Text="BUILD / TYPE" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="VehBuildTypeText" Text="-" FontSize="11" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ENGINE SPECS CARD -->
                        <Border Grid.Column="1" Margin="4" Padding="12,10" Background="#141414" CornerRadius="14" BorderBrush="#262832" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="EngSpecsTitleText" Text="ENGINE SPECS" FontSize="11" Foreground="#3B82F6" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2,0,0">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                                        <TextBlock x:Name="LblNameTypeText" Text="NAME / TYPE" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EngNameTypeText" Text="-" FontSize="12" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,4">
                                        <TextBlock x:Name="LblDisplacementText" Text="DISPLACEMENT" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EngDisplacementText" Text="-" FontSize="12" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,4">
                                        <TextBlock x:Name="LblOutputText" Text="OUTPUT (PS / KW)" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EngOutputText" Text="-" FontSize="11" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,4">
                                        <TextBlock x:Name="LblEmissionText" Text="EMISSION" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EngEmissionText" Text="-" FontSize="11" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,0">
                                        <TextBlock x:Name="LblTransmissionText" Text="TRANSMISSION" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EngTransmissionText" Text="-" FontSize="11" Foreground="#CCCCCC" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ECU SPECS CARD -->
                        <Border Grid.Column="2" Margin="4" Padding="12,10" Background="#141414" CornerRadius="14" BorderBrush="#262832" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="EcuSpecsTitleText" Text="ECU SPECS" FontSize="11" Foreground="#A855F7" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,2,0,0">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                                        <TextBlock x:Name="LblProdBuildText" Text="PRODUCER / BUILD" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EcuBrandText" Text="Not Loaded" FontSize="12" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,4">
                                        <TextBlock x:Name="LblHwNrText" Text="STAGE / HW NR" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EcuHardwareText" Text="Not Loaded" FontSize="12" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,4">
                                        <TextBlock x:Name="LblProdNrText" Text="PART / PROD NR" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EcuProdNrText" Text="-" FontSize="11" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,4">
                                        <TextBlock x:Name="LblSwVersionText" Text="SW VERSION" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EcuSoftwareText" Text="Not Loaded" FontSize="11" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock x:Name="LblSwSizeText" Text="SW SIZE" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EcuSoftwareSizeText" Text="-" FontSize="11" Foreground="#CCCCCC" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock x:Name="LblStatusText" Text="STATUS" FontSize="9" Foreground="#888888" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,0,0">
                                            <Border x:Name="StatusDot" Width="8" Height="8" CornerRadius="4" Background="Gray" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                        <TextBlock x:Name="LblReadHwText" Text="READ HARDWARE" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EcuReadHardwareText" Text="-" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </Grid>
                </ScrollViewer>

                <!-- WORKFLOW / ORDER MODE TABS (HIGHER STRUCTURE) -->
                <Border x:Name="WorkflowTabsBar"
                        Grid.Row="1"
                        IsVisible="{Binding IsVisible, ElementName=ServicesContainer}"
                        Margin="0,0,0,12"
                        Padding="4"
                        Background="#14161D"
                        BorderBrush="#252A38"
                        BorderThickness="1"
                        CornerRadius="12"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <!-- TAB 1: TUNING & REMAP -->
                        <Button x:Name="WorkflowTabTuning"
                                Click="WorkflowTabTuning_Click"
                                Padding="16,8"
                                Background="#14281E"
                                BorderBrush="#4DFF8A"
                                BorderThickness="1"
                                CornerRadius="8"
                                Cursor="Hand">
                            <TextBlock x:Name="WorkflowTabTuningText" 
                                       Text="🛠️ ECU Tuning &amp; Remap" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="#4DFF8A" 
                                       VerticalAlignment="Center"/>
                        </Button>

                        <!-- TAB 2: ORIGINAL FILES -->
                        <Button x:Name="OriginalFilesButton"
                                Click="OriginalFilesButton_Click"
                                Padding="16,8"
                                Background="#1A1D24"
                                BorderBrush="#262933"
                                BorderThickness="1"
                                CornerRadius="8"
                                Cursor="Hand"
                                IsVisible="False">
                            <TextBlock x:Name="OriginalFilesBtnText" 
                                       Text="📁 Original Files (0)" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="#38BDF8" 
                                       VerticalAlignment="Center"/>
                        </Button>

                        <!-- TAB 3: DTC OFF -->
                        <!-- TAB 3: DTC OFF & DIAGNOSTICS (Gated by AppConfig.EnableDtcFeature) -->
                        <Button x:Name="DtcOffButton"
                                Click="DtcOffButton_Click"
                                IsVisible="False"
                                Padding="16,8"
                                Background="#1A1D24"
                                BorderBrush="#262933"
                                BorderThickness="1"
                                CornerRadius="8"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="DtcOffBtnText" 
                                           Text="⚡ DTC Off &amp; Diagnostics" 
                                           FontSize="12" 
                                           FontWeight="Bold" 
                                           Foreground="#9CA3AF" 
                                           VerticalAlignment="Center"/>
                                <Border x:Name="DtcOffBadgeBorder"
                                        Background="#332612" 
                                        BorderBrush="#F59E0B"
                                        BorderThickness="1"
                                        CornerRadius="4" 
                                        Padding="6,1" 
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="DtcOffBadgeText" 
                                               Text="PRO" 
                                               FontSize="9" 
                                               FontWeight="Bold" 
                                               Foreground="#FBBF24"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- DYNAMIC SERVICES / TUNES CONTAINER -->
                <Grid x:Name="ServicesContainer"
                      Grid.Row="2"
                      IsVisible="False">
                    <!-- TUNING & REMAP SERVICES SECTION -->
                    <ScrollViewer x:Name="TuningServicesScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  IsVisible="True">
                        <StackPanel x:Name="TuningServicesSection" Spacing="12">
                            <StackPanel x:Name="ServicesHeaderPanel" Spacing="12">
                                <!-- HEADER & SUMMARY COUNTER BAR -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,4,0,4">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock x:Name="AvailableTunesTitleText"
                                                   Text="AVAILABLE DATABASE TUNES &amp; MODIFICATIONS" 
                                                   FontSize="13" 
                                                   FontWeight="Bold" 
                                                   Foreground="#4DFF8A"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- LIVE SUMMARY CHIP -->
                                    <Border Grid.Column="1" 
                                            Background="#141E17" 
                                            BorderBrush="#255233" 
                                            BorderThickness="1" 
                                            CornerRadius="12" 
                                            Padding="12,6"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock x:Name="LblSummarySelectedText" Text="Selected:" FontSize="11" Foreground="#888888"/>
                                                <TextBlock x:Name="SummarySelectedCountText" Text="0 Tunes" FontSize="11" FontWeight="Bold" Foreground="#4DFF8A"/>
                                            </StackPanel>
                                            <TextBlock Text="•" Foreground="#444444" FontSize="11"/>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock x:Name="LblSummaryTotalText" Text="Total:" FontSize="11" Foreground="#888888"/>
                                                <TextBlock x:Name="SummaryTotalTokensText" Text="0 CBT" FontSize="11" FontWeight="Bold" Foreground="#3B82F6"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- CATEGORY FILTER TABS -->
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                    <Button x:Name="FilterAllButton" 
                                            Content="All Options" 
                                            Click="FilterButton_Click" 
                                            Tag="ALL"
                                            Padding="14,6" 
                                            FontSize="11" 
                                            FontWeight="SemiBold" 
                                            Background="#4DFF8A" 
                                            Foreground="#0F172A" 
                                            CornerRadius="8" 
                                            Cursor="Hand"/>
                                    <Button x:Name="FilterPerfButton" 
                                            Content="🚀 Performance" 
                                            Click="FilterButton_Click" 
                                            Tag="PERFORMANCE"
                                            Padding="14,6" 
                                            FontSize="11" 
                                            FontWeight="SemiBold" 
                                            Background="#22242D" 
                                            Foreground="#CCCCCC" 
                                            CornerRadius="8" 
                                            Cursor="Hand"/>
                                    <Button x:Name="FilterDeletesButton" 
                                            Content="🛡️ Deletes" 
                                            Click="FilterButton_Click" 
                                            Tag="DELETES"
                                            Padding="14,6" 
                                            FontSize="11" 
                                            FontWeight="SemiBold" 
                                            Background="#22242D" 
                                            Foreground="#CCCCCC" 
                                            CornerRadius="8" 
                                            Cursor="Hand"/>
                                    <Button x:Name="FilterFeaturesButton" 
                                            Content="⚡ Special Features" 
                                            Click="FilterButton_Click" 
                                            Tag="FEATURES"
                                            Padding="14,6" 
                                            FontSize="11" 
                                            FontWeight="SemiBold" 
                                            Background="#22242D" 
                                            Foreground="#CCCCCC" 
                                            CornerRadius="8" 
                                            Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- CARDS WRAP PANEL -->
                            <WrapPanel x:Name="DynamicServicesPanel" 
                                       Orientation="Horizontal" 
                                       Margin="0,4,0,6"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- INLINE FACTORY ORIGINAL FILES SECTION -->
                    <ScrollViewer x:Name="OriginalFilesScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  IsVisible="False">
                        <StackPanel x:Name="OriginalFilesSection" Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,4,0,8">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock x:Name="OriginalModalTitleText"
                                               Text="📁 Available Factory Original Files"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#38BDF8"/>
                                    <TextBlock x:Name="OriginalModalDescText"
                                               Text="Select the factory original binary matching your flasher hardware and software version."
                                               FontSize="12"
                                               Foreground="#9CA3AF"/>
                                </StackPanel>
                                <TextBlock x:Name="OriginalFilesPageInfoText"
                                           Grid.Column="1"
                                           Text=""
                                           FontSize="12"
                                           Foreground="#9CA3AF"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel x:Name="OriginalMatchesContainer" Spacing="10"/>

                            <!-- PAGINATION CONTROLS BAR -->
                            <Border x:Name="OriginalFilesPaginationBar"
                                    Margin="0,6,0,0"
                                    Padding="14,8"
                                    Background="#141822"
                                    BorderBrush="#263147"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    IsVisible="False">
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                    <Button x:Name="OriginalPrevPageBtn"
                                            Content="◀ Previous"
                                            Click="OriginalPrevPage_Click"
                                            Background="#1E293B"
                                            Foreground="#38BDF8"
                                            BorderBrush="#0284C7"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Padding="14,6"
                                            Cursor="Hand"/>

                                    <TextBlock x:Name="OriginalPageNumberText"
                                               Grid.Column="1"
                                               Text="Page 1 of 1"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#CCCCCC"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <Button x:Name="OriginalNextPageBtn"
                                            Grid.Column="2"
                                            Content="Next ▶"
                                            Click="OriginalNextPage_Click"
                                            Background="#1E293B"
                                            Foreground="#38BDF8"
                                            BorderBrush="#0284C7"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Padding="14,6"
                                            Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="OriginalModalStatusText"
                                       Text=""
                                       FontSize="12"
                                       Foreground="#FBBF24"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- DTC OFF & DIAGNOSTICS SECTION -->
                    <Grid x:Name="DtcSection"
                          RowDefinitions="Auto,*,Auto"
                          IsVisible="False">
                        <!-- FIXED TOP BAR -->
                        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
                            <!-- HEADER ROW WITH TITLE & COUNTER CHIP -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock x:Name="DtcSectionTitleText"
                                               Text="⚡ Diagnostic Trouble Code (DTC) Customization"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#FBBF24"/>
                                    <TextBlock x:Name="DtcSectionDescText"
                                               Text="Select DTC codes to turn OFF or restore to stock factory state for this ECU."
                                               FontSize="12"
                                               Foreground="#9CA3AF"/>
                                </StackPanel>

                                <!-- SELECTION COUNTER BADGE -->
                                <Border Grid.Column="1" 
                                        Background="#261E14" 
                                        BorderBrush="#78350F" 
                                        BorderThickness="1" 
                                        CornerRadius="12" 
                                        Padding="12,6"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock x:Name="LblDtcOffText" Text="OFF:" FontSize="11" Foreground="#F87171" FontWeight="Bold"/>
                                            <TextBlock x:Name="DtcOffCountText" Text="0" FontSize="11" FontWeight="Bold" Foreground="#F87171"/>
                                        </StackPanel>
                                        <TextBlock Text="•" Foreground="#444444" FontSize="11"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock x:Name="LblDtcOnText" Text="ON:" FontSize="11" Foreground="#4ADE80" FontWeight="Bold"/>
                                            <TextBlock x:Name="DtcOnCountText" Text="0" FontSize="11" FontWeight="Bold" Foreground="#4ADE80"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- SEARCH BAR & MANUAL CUSTOM P-CODE INPUT ROW -->
                            <Border Background="#14161D"
                                    BorderBrush="#252A38"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10,8">
                                <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                                    <!-- Instant Search Box -->
                                    <TextBox x:Name="DtcSearchBox"
                                             Grid.Column="0"
                                             Watermark="🔍 Filter DTCs by code or description (e.g. P0420, EGR, Catalyst)..."
                                             Background="#1A1D24"
                                             Foreground="White"
                                             BorderBrush="#2E3342"
                                             CornerRadius="8"
                                             Padding="10,6"
                                             FontSize="12"
                                             Margin="0,0,8,0"/>

                                    <!-- Custom P-Code Input -->
                                    <TextBox x:Name="DtcCustomInput"
                                             Grid.Column="1"
                                             Watermark="Custom P-Code"
                                             MaxLength="6"
                                             Width="130"
                                             Background="#1A1D24"
                                             Foreground="White"
                                             BorderBrush="#2E3342"
                                             CornerRadius="8"
                                             Padding="10,6"
                                             FontSize="12"
                                             Margin="0,0,8,0"/>

                                    <!-- Add Custom DTC Button -->
                                    <Button x:Name="DtcAddCustomBtn"
                                            Grid.Column="2"
                                            Content="+ Add Code"
                                            Click="DtcAddCustomBtn_Click"
                                            Background="#1E293B"
                                            Foreground="#38BDF8"
                                            BorderBrush="#0284C7"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Padding="14,6"
                                            Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- QUICK ACTIONS BAR -->
                            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,2,0,2">
                                <TextBlock x:Name="DtcResultsCountText"
                                           Grid.Column="0"
                                           Text="Detected Fault Codes"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#CCCCCC"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="DtcTurnAllOffBtn"
                                            Content="🔴 Turn All OFF"
                                            Click="DtcTurnAllOff_Click"
                                            Background="#2D1515"
                                            Foreground="#F87171"
                                            BorderBrush="#7F1D1D"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            FontSize="11"
                                            Padding="10,4"
                                            Cursor="Hand"/>

                                    <Button x:Name="DtcResetAllBtn"
                                            Content="⚪ Reset to Stock"
                                            Click="DtcResetAll_Click"
                                            Background="#1E222D"
                                            Foreground="#9CA3AF"
                                            BorderBrush="#2E3342"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            FontSize="11"
                                            Padding="10,4"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- SCROLLABLE P-CODES VIEWPORT -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8" Margin="0,0,6,0">
                                <!-- DTC CARDS CONTAINER -->
                                <StackPanel x:Name="DtcCardsContainer" Spacing="8"/>

                                <!-- EMPTY STATE BLOCK -->
                                <Border x:Name="DtcEmptyStateBorder"
                                        Background="#141822"
                                        BorderBrush="#263147"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="24"
                                        IsVisible="False"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <TextBlock x:Name="DtcEmptyStateTitleText"
                                                   Text="🔍 No diagnostic trouble codes detected or matching search."
                                                   Foreground="#9CA3AF"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="DtcEmptyStateDescText"
                                                   Text="You can add any specific OBD-II P-Code manually using the input above."
                                                   Foreground="#6B7280"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- FIXED BOTTOM BAR -->
                        <StackPanel Grid.Row="2" Spacing="6" Margin="0,6,0,0">
                            <!-- DTC PAGINATION CONTROLS BAR -->
                            <Border x:Name="DtcPaginationBar"
                                    Margin="0,0,0,0"
                                    Padding="14,8"
                                    Background="#141822"
                                    BorderBrush="#263147"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    IsVisible="False">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">
                                    <Button x:Name="DtcFirstPageBtn"
                                            Grid.Column="0"
                                            Content="⏮"
                                            Click="DtcFirstPage_Click"
                                            Background="#1E293B"
                                            Foreground="#38BDF8"
                                            BorderBrush="#0284C7"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Padding="10,6"
                                            Margin="0,0,6,0"
                                            Cursor="Hand"/>

                                    <Button x:Name="DtcPrevPageBtn"
                                            Grid.Column="1"
                                            Content="◀ Previous"
                                            Click="DtcPrevPage_Click"
                                            Background="#1E293B"
                                            Foreground="#38BDF8"
                                            BorderBrush="#0284C7"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Padding="14,6"
                                            Cursor="Hand"/>

                                    <TextBlock x:Name="DtcPageNumberText"
                                               Grid.Column="2"
                                               Text="Page 1 of 1"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#CCCCCC"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <Button x:Name="DtcNextPageBtn"
                                            Grid.Column="3"
                                            Content="Next ▶"
                                            Click="DtcNextPage_Click"
                                            Background="#1E293B"
                                            Foreground="#38BDF8"
                                            BorderBrush="#0284C7"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Padding="14,6"
                                            Margin="0,0,6,0"
                                            Cursor="Hand"/>

                                    <Button x:Name="DtcLastPageBtn"
                                            Grid.Column="4"
                                            Content="⏭"
                                            Click="DtcLastPage_Click"
                                            Background="#1E293B"
                                            Foreground="#38BDF8"
                                            BorderBrush="#0284C7"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Padding="10,6"
                                            Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- DTC SUBMIT ORDER ROW -->
                            <Border Margin="0,0,0,0"
                                    Padding="14,10"
                                    Background="#141822"
                                    BorderBrush="#263147"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="DtcOrderStatusText"
                                                   Text="Ready to submit DTC modifications"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#9CA3AF"/>
                                        <TextBlock x:Name="DtcOrderSubHintText"
                                                   Text="✓ Covered with active tuning subscription"
                                                   FontSize="11"
                                                   Foreground="#4DFF8A"/>
                                    </StackPanel>

                                    <Button x:Name="DtcSubmitOrderBtn"
                                            Grid.Column="1"
                                            Content="⚡ Order DTC Modification"
                                            Click="DtcSubmitOrderBtn_Click"
                                            Background="#F59E0B"
                                            Foreground="#141414"
                                            FontWeight="Bold"
                                            FontSize="12"
                                            CornerRadius="8"
                                            Padding="18,8"
                                            Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
                <Border Name="DropZone"
                        Grid.Row="2"
                        IsVisible="{Binding !IsVisible, ElementName=ServicesContainer}"
                        DragDrop.AllowDrop="True"
                        Background="#141414" 
                        BorderBrush="#262832"
                        BorderThickness="2"
                        CornerRadius="14"
                        Padding="40"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Cursor="Hand"
                        PointerPressed="DropZone_PointerPressed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="📁" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DragDropHintText"
                                   Text="Drag and drop files here" 
                                   FontSize="13"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- ACTION BUTTONS -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,15,0,0"
                            Spacing="18">

                    <Button x:Name="SaveButton"
                            MinWidth="280"
                            Height="46"
                            Padding="32,0"
                            Background="White"
                            Foreground="#141414"
                            FontWeight="Bold"
                            FontSize="14"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            CornerRadius="12"
                            Content="📁 Select ECU File to Upload"
                            Click="Save_Click"
                            Cursor="Hand"/>

                </StackPanel>

            </Grid>
        </Border>

        <!-- ORDER PROCESSING MODAL (SPINNER & STATUS ONLY) -->
        <Border x:Name="OrderProgressOverlay"
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Background="#D0000000"
                IsVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#1C1C1E"
                    BorderBrush="#2A2D3A"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="32"
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <ProgressBar x:Name="OrderProgressBar"
                                 IsIndeterminate="True"
                                 Width="260"
                                 Height="6"
                                 Foreground="#4DFF8A"
                                 Background="#2C2E3B"
                                 CornerRadius="3"
                                 HorizontalAlignment="Center"/>
                    <TextBlock x:Name="OrderProgressTitle"
                               Text="Processing Order..."
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="OrderProgressStatus"
                               Text="Submitting order and waiting for ECU tuning..."
                               FontSize="12"
                               Foreground="#9CA3AF"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="380"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>



    </Grid>

</UserControl>
