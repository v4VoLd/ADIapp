<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="800"
             x:Class="ADIapp.Views.TuneView"
             DragDrop.AllowDrop="True">

    <!-- ================= THEME ACCENT OVERRIDES ================= -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#4DFF8A"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnHover" Color="#66FF9E"/>
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#33EE77"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#4DFF8A"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnHover" Color="#66FF9E"/>
        <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#33EE77"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0F172A"/>
        <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#4DFF8A"/>
    </UserControl.Resources>

    <!-- ================= TOGGLE & BUTTON STYLES ================= -->
    <UserControl.Styles>
        <!-- Toggle OFF -->
        <Style Selector="ToggleSwitch /template/ Border#PART_Track">
            <Setter Property="Background" Value="#22242D"/>
            <Setter Property="BorderBrush" Value="#383C4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <!-- Toggle ON (Emerald Green) -->
        <Style Selector="ToggleSwitch:checked /template/ Border#PART_Track">
            <Setter Property="Background" Value="#4DFF8A"/>
            <Setter Property="BorderBrush" Value="#4DFF8A"/>
        </Style>
        <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#PART_Track">
            <Setter Property="Background" Value="#66FF9E"/>
            <Setter Property="BorderBrush" Value="#66FF9E"/>
        </Style>

        <!-- Toggle thumb -->
        <Style Selector="ToggleSwitch /template/ Border#PART_Thumb">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <!-- Action Buttons Hover -->
        <Style Selector="Button.action-btn">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- TITLE / HEADER WITH BACK BUTTON & DAILY QUOTA -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="30,20,30,10">

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="14"
                        VerticalAlignment="Center">

                <!-- BACK BUTTON -->
                <Button x:Name="BackButton"
                        Click="Back_Click"
                        Content="← Back"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#CFCFCF"
                        Background="#242430"
                        Padding="14,8"
                        CornerRadius="10"
                        Margin="0,0,8,0"
                        Cursor="Hand"/>

                <Image Source="avares://ADIapp/Assets/sidebar_logo.png"
                       Width="36"
                       Height="36"
                       VerticalAlignment="Center"/>

                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="VehicleTitleText"
                               Text="Vehicle &amp; ECU Information"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock x:Name="VehicleSubtitleText"
                               Text="Upload a binary file or select an active task to inspect specifications."
                               FontSize="12"
                               Foreground="#4DFF8A"/>
                </StackPanel>
            </StackPanel>

            <!-- DAILY QUOTA BADGE (COMMENTED OUT)
            <Border Grid.Column="1"
                    Background="#18181A"
                    BorderBrush="#2A2D3A"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="30"
                            Height="30"
                            CornerRadius="8"
                            Background="#24242A"
                            VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TuneDailyQuotaTitleText"
                                   Text="Daily Quota"
                                   FontSize="10"
                                   Foreground="#9E9EA0"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="TuneDailyQuotaValueText"
                                   Text="Unlimited"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#4DFF8A"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            -->
        </Grid>

        <!-- MAIN CARD -->
        <Border Grid.Row="1"
                Margin="30,10,30,30"
                Padding="24,20"
                CornerRadius="22"
                Background="#1C1C1C"
                Opacity="0.95"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- TOP DETAILS SECTION (VEHICLE, ENGINE, ECU CARDS) -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="300" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto">
                        
                        <!-- VEHICLE SPECS CARD -->
                        <Border Grid.Column="0" Margin="4" Padding="12,10" Background="#141414" CornerRadius="14" BorderBrush="#262832" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="VehSpecsTitleText" Text="VEHICLE SPECS" FontSize="11" Foreground="#4DFF8A" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,2,0,0">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                                        <TextBlock x:Name="LblProducerText" Text="PRODUCER" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="VehProducerText" Text="-" FontSize="12" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,4">
                                        <TextBlock x:Name="LblModelText" Text="MODEL" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="VehModelText" Text="-" FontSize="12" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock x:Name="LblYearChassisText" Text="YEAR / CHASSIS" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="VehYearChassisText" Text="-" FontSize="11" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock x:Name="LblBuildTypeText" Text="BUILD / TYPE" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="VehBuildTypeText" Text="-" FontSize="11" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ENGINE SPECS CARD -->
                        <Border Grid.Column="1" Margin="4" Padding="12,10" Background="#141414" CornerRadius="14" BorderBrush="#262832" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="EngSpecsTitleText" Text="ENGINE SPECS" FontSize="11" Foreground="#3B82F6" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2,0,0">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                                        <TextBlock x:Name="LblNameTypeText" Text="NAME / TYPE" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EngNameTypeText" Text="-" FontSize="12" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,4">
                                        <TextBlock x:Name="LblDisplacementText" Text="DISPLACEMENT" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EngDisplacementText" Text="-" FontSize="12" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,4">
                                        <TextBlock x:Name="LblOutputText" Text="OUTPUT (PS / KW)" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EngOutputText" Text="-" FontSize="11" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,4">
                                        <TextBlock x:Name="LblEmissionText" Text="EMISSION" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EngEmissionText" Text="-" FontSize="11" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,0">
                                        <TextBlock x:Name="LblTransmissionText" Text="TRANSMISSION" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EngTransmissionText" Text="-" FontSize="11" Foreground="#CCCCCC" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ECU SPECS CARD -->
                        <Border Grid.Column="2" Margin="4" Padding="12,10" Background="#141414" CornerRadius="14" BorderBrush="#262832" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="EcuSpecsTitleText" Text="ECU SPECS" FontSize="11" Foreground="#A855F7" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2,0,0">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                                        <TextBlock x:Name="LblProdBuildText" Text="PRODUCER / BUILD" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EcuBrandText" Text="Not Loaded" FontSize="12" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,4">
                                        <TextBlock x:Name="LblHwNrText" Text="STAGE / HW NR" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EcuHardwareText" Text="Not Loaded" FontSize="12" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,4">
                                        <TextBlock x:Name="LblProdNrText" Text="PART / PROD NR" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EcuProdNrText" Text="-" FontSize="11" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,4">
                                        <TextBlock x:Name="LblSwVersionText" Text="SW VERSION" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EcuSoftwareText" Text="Not Loaded" FontSize="11" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock x:Name="LblSwSizeText" Text="SW SIZE" FontSize="9" Foreground="#888888" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="EcuSoftwareSizeText" Text="-" FontSize="11" Foreground="#CCCCCC" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="STATUS" FontSize="9" Foreground="#888888" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,0,0">
                                            <Border x:Name="StatusDot" Width="8" Height="8" CornerRadius="4" Background="Gray" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </Grid>
                </ScrollViewer>

                <!-- DYNAMIC SERVICES / TUNES CONTAINER -->
                <ScrollViewer x:Name="ServicesContainer"
                               Grid.Row="1"
                               IsVisible="False"
                               VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">

                        <!-- HEADER & SUMMARY COUNTER BAR -->
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" Margin="0,4,0,4">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock x:Name="AvailableTunesTitleText"
                                           Text="AVAILABLE DATABASE TUNES &amp; MODIFICATIONS" 
                                           FontSize="13" 
                                           FontWeight="Bold" 
                                           Foreground="#4DFF8A"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- LIVE SUMMARY CHIP -->
                            <Border Grid.Column="1" 
                                    Background="#141E17" 
                                    BorderBrush="#255233" 
                                    BorderThickness="1" 
                                    CornerRadius="12" 
                                    Padding="12,6"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Selected:" FontSize="11" Foreground="#888888"/>
                                        <TextBlock x:Name="SummarySelectedCountText" Text="0 Tunes" FontSize="11" FontWeight="Bold" Foreground="#4DFF8A"/>
                                    </StackPanel>
                                    <TextBlock Text="•" Foreground="#444444" FontSize="11"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Total:" FontSize="11" Foreground="#888888"/>
                                        <TextBlock x:Name="SummaryTotalTokensText" Text="0 CBT" FontSize="11" FontWeight="Bold" Foreground="#3B82F6"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- CATEGORY FILTER TABS BAR -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                            <Button x:Name="FilterAllButton" 
                                    Content="All Options" 
                                    Click="FilterButton_Click" 
                                    Tag="ALL"
                                    Padding="14,6" 
                                    FontSize="11" 
                                    FontWeight="SemiBold" 
                                    Background="#4DFF8A" 
                                    Foreground="#0F172A" 
                                    CornerRadius="8" 
                                    Cursor="Hand"/>
                            <Button x:Name="FilterPerfButton" 
                                    Content="🚀 Performance" 
                                    Click="FilterButton_Click" 
                                    Tag="PERFORMANCE"
                                    Padding="14,6" 
                                    FontSize="11" 
                                    FontWeight="SemiBold" 
                                    Background="#22242D" 
                                    Foreground="#CCCCCC" 
                                    CornerRadius="8" 
                                    Cursor="Hand"/>
                            <Button x:Name="FilterDeletesButton" 
                                    Content="🛡️ Deletes" 
                                    Click="FilterButton_Click" 
                                    Tag="DELETES"
                                    Padding="14,6" 
                                    FontSize="11" 
                                    FontWeight="SemiBold" 
                                    Background="#22242D" 
                                    Foreground="#CCCCCC" 
                                    CornerRadius="8" 
                                    Cursor="Hand"/>
                            <Button x:Name="FilterFeaturesButton" 
                                    Content="⚡ Special Features" 
                                    Click="FilterButton_Click" 
                                    Tag="FEATURES"
                                    Padding="14,6" 
                                    FontSize="11" 
                                    FontWeight="SemiBold" 
                                    Background="#22242D" 
                                    Foreground="#CCCCCC" 
                                    CornerRadius="8" 
                                    Cursor="Hand"/>
                        </StackPanel>

                        <!-- CARDS WRAP PANEL -->
                        <WrapPanel x:Name="DynamicServicesPanel" 
                                   Orientation="Horizontal" 
                                   Margin="0,4,0,6"/>
                    </StackPanel>
                </ScrollViewer>
                <Border Name="DropZone"
                        Grid.Row="1"
                        IsVisible="{Binding !IsVisible, ElementName=ServicesContainer}"
                        DragDrop.AllowDrop="True"
                        Background="#141414" 
                        BorderBrush="#262832"
                        BorderThickness="2"
                        CornerRadius="14"
                        Padding="40"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="📁" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DragDropHintText"
                                   Text="Drag and drop files here" 
                                   FontSize="13"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- ACTION BUTTONS -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,15,0,0"
                            Spacing="18">

                    <Button x:Name="SaveButton"
                            MinWidth="280"
                            Height="46"
                            Padding="32,0"
                            Background="White"
                            Foreground="#141414"
                            FontWeight="Bold"
                            FontSize="14"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            CornerRadius="12"
                            Content="📁 Select ECU File to Upload"
                            Click="Save_Click"
                            Cursor="Hand"/>

                </StackPanel>

            </Grid>
        </Border>

        <!-- ORDER PROCESSING MODAL (SPINNER & STATUS ONLY) -->
        <Border x:Name="OrderProgressOverlay"
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Background="#D0000000"
                IsVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#1C1C1E"
                    BorderBrush="#2A2D3A"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="32"
                    MaxWidth="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="20" HorizontalAlignment="Center">
                    <ProgressBar x:Name="OrderProgressBar"
                                 IsIndeterminate="True"
                                 Width="260"
                                 Height="6"
                                 Foreground="#4DFF8A"
                                 Background="#2C2E3B"
                                 CornerRadius="3"
                                 HorizontalAlignment="Center"/>
                    <TextBlock x:Name="OrderProgressTitle"
                               Text="Processing Order..."
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="OrderProgressStatus"
                               Text="Submitting order and waiting for ECU tuning..."
                               FontSize="12"
                               Foreground="#9CA3AF"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="380"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>

    </Grid>

</UserControl>
