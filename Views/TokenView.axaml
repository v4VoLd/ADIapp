<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="800"
             x:Class="ADIapp.Views.TokenView">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MinHeight="600" Margin="32,40">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="560"
                        Spacing="28">

                <!-- TITLE HEADER -->
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock x:Name="TokenTitleBlock"
                               Text="Token Credits"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TokenSubtitleBlock"
                               Text="Your current available service tokens balance"
                               FontSize="13"
                               Foreground="#A0A0B0"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- CARD CONTAINER -->
                <Border Background="#181818"
                        BorderBrush="#2D2D2D"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="36,32">
                    <StackPanel Spacing="20" HorizontalAlignment="Center">

                        <!-- TOKEN DISPLAY BOX -->
                        <Border Background="#252525"
                                BorderBrush="#3D3D3D"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="28,20"
                                HorizontalAlignment="Center"
                                MinWidth="260">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Background="#1F1F1F"
                                        CornerRadius="10"
                                        Width="44"
                                        Height="44">
                                    <TextBlock Text="🪙"
                                               FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="AvailableBalanceLabelBlock"
                                               Text="Available Balance"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#A0A0B0"/>
                                    <TextBlock x:Name="TokenText"
                                               Text="8 Token"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>

</UserControl>
