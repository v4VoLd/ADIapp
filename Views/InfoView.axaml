<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="800"
             x:Class="ADIapp.Views.InfoView">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MinHeight="600" Margin="32,40">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="640"
                        Spacing="28">

                <!-- TITLE HEADER -->
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock x:Name="InfoTitleBlock"
                               Text="About Us"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="InfoSubtitleBlock"
                               Text="Platform information, support contacts, and official channels"
                               FontSize="13"
                               Foreground="#A0A0B0"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- CARD CONTAINER -->
                <Border Background="#181818"
                        BorderBrush="#2D2D2D"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="36,32">

                    <!-- INFO TILES GRID -->
                    <UniformGrid Columns="2" HorizontalAlignment="Stretch">
                        
                        <!-- WEBSITE TILE -->
                        <Border Background="#252525"
                                BorderBrush="#3D3D3D"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20,18"
                                Margin="8">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🌐" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="WebsiteTileBlock"
                                               Text="Our Website"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="adi-performance.com"
                                           FontSize="13"
                                           Foreground="#CFCFCF"/>
                            </StackPanel>
                        </Border>

                        <!-- UPDATES TILE -->
                        <Border Background="#252525"
                                BorderBrush="#3D3D3D"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20,18"
                                Margin="8">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🔄" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="UpdatesTileBlock"
                                               Text="Updates"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="adi-performance.com"
                                           FontSize="13"
                                           Foreground="#CFCFCF"/>
                            </StackPanel>
                        </Border>

                        <!-- NEWS TILE -->
                        <Border Background="#252525"
                                BorderBrush="#3D3D3D"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20,18"
                                Margin="8">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="📰" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="NewsTileBlock"
                                               Text="News &amp; Portal"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="adi-performance.com"
                                           FontSize="13"
                                           Foreground="#CFCFCF"/>
                            </StackPanel>
                        </Border>

                        <!-- PHONE TILE -->
                        <Border Background="#252525"
                                BorderBrush="#3D3D3D"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20,18"
                                Margin="8">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="📞" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PhoneTileBlock"
                                               Text="Phone Support"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="05515454564"
                                           FontSize="13"
                                           Foreground="#CFCFCF"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>

</UserControl>
