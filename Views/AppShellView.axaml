<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:ADIapp.Views"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="800"
             x:Class="ADIapp.Views.AppShellView">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== SIDEBAR ===================== -->
        <views:SidebarView Grid.Column="0"/>

        <!-- ===================== MAIN ===================== -->
        <Grid Grid.Column="1">

            <!-- Background image -->
            <Image Source="avares://ADIapp/Assets/main_background.png"
                   Stretch="UniformToFill"/>

            <!-- PAGE CONTENT SLOT -->
            <ContentControl x:Name="PageContent"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>

            <!-- TOP RIGHT USER SECTION (overlay) -->
            <views:TopUserPanelView
                x:Name="TopUserPanel"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,18,18,0"
                ZIndex="999"/>

        </Grid>
    </Grid>

</UserControl>
