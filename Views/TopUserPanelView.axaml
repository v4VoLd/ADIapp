<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 d:DesignWidth="400"
			 d:DesignHeight="120"
			 x:Class="ADIapp.Views.TopUserPanelView">

	<Grid VerticalAlignment="Top">
		<!-- MAIN ROW -->
		<StackPanel Orientation="Horizontal"
					HorizontalAlignment="Right"
					VerticalAlignment="Top"
					Spacing="12">

			<!-- 🔔 BELL BUTTON -->
			<Panel VerticalAlignment="Top">
				<Border Classes="bell-btn"
						Width="44"
						Height="44"
						CornerRadius="12"
						Background="#2A2A2A"
						BorderBrush="#3D3D3D"
						BorderThickness="1"
						Cursor="Hand"
						PointerPressed="Bell_Click">
					<TextBlock Text="🔔"
							   FontSize="18"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center"/>
				</Border>
				<!-- Badge Red Dot -->
				<Border x:Name="NotificationBadge"
						Width="10"
						Height="10"
						CornerRadius="5"
						Background="#FF4D4D"
						BorderBrush="#141414"
						BorderThickness="1.5"
						HorizontalAlignment="Right"
						VerticalAlignment="Top"
						Margin="0,0,0,0"
						IsVisible="False"
						IsHitTestVisible="False"/>
			</Panel>

			<!-- 👤 USER COMPONENT CARD (TALL FULL HEIGHT) -->
			<Border Classes="user-card"
					CornerRadius="14"
					Background="#2A2A2A"
					BorderBrush="#3D3D3D"
					BorderThickness="1"
					Padding="12"
					Cursor="Hand"
					VerticalAlignment="Top"
					PointerPressed="User_Click">

				<Grid ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">


					<!-- Text Stack (3-Lines Tall) -->
					<StackPanel Grid.Column="1" VerticalAlignment="Center">
						<TextBlock x:Name="HelloLabelBlock"
								   Text="Hello,"
								   FontSize="11"
								   Foreground="#CFCFCF"/>
						<TextBlock x:Name="UserNameBlock"
								   Text="John Doe"
								   FontSize="13"
								   FontWeight="Bold"
								   Foreground="White"/>
						<Border Background="#1F1F1F"
								CornerRadius="8"
								Padding="8,3"
								Margin="0,4,0,0">
							<TextBlock x:Name="UserTokenBlock"
									   Text="Token: 8"
									   FontSize="11"
									   Foreground="White"/>
						</Border>
					</StackPanel>

					<!-- Dropdown Indicator Arrow -->
					<TextBlock Grid.Column="2"
							   Text="▾"
							   FontSize="12"
							   Foreground="#A0A0B0"
							   VerticalAlignment="Center"
							   Margin="8,0,0,0"/>
				</Grid>
			</Border>
		</StackPanel>

		<!-- NOTIFICATION MENU -->
		<Border x:Name="NotificationMenu"
				IsVisible="False"
				Margin="0,74,130,0"
				Width="340"
				HorizontalAlignment="Right"
				VerticalAlignment="Top"
				CornerRadius="14"
				Background="#181818"
				BorderBrush="#2D2D2D"
				BorderThickness="1"
				Padding="16"
				BoxShadow="0 8 24 0 #80000000"
				ZIndex="10">

			<StackPanel Spacing="12">
				<Grid ColumnDefinitions="*,Auto">
					<TextBlock x:Name="NotifTitleBlock"
							   Text="Notifications"
							   FontWeight="Bold"
							   FontSize="15"
							   Foreground="White"
							   VerticalAlignment="Center"/>
					<Button x:Name="ClearAllBtn"
							Grid.Column="1"
							Content="Clear All"
							FontSize="11"
							FontWeight="SemiBold"
							Background="Transparent"
							Foreground="#A0A0B0"
							Padding="8,4"
							BorderThickness="0"
							Cursor="Hand"
							Click="ClearNotifications_Click"/>
				</Grid>

				<Separator Height="1" Background="#2A2A2A"/>

				<ScrollViewer MaxHeight="300">
					<StackPanel x:Name="NotificationsList" Spacing="8">
						<!-- Notifications will be added dynamically here -->
					</StackPanel>
				</ScrollViewer>
			</StackPanel>
		</Border>

		<!-- EXPANDED MENU -->
		<Border x:Name="Menu"
				IsVisible="False"
				Margin="0,74,0,0"
				Width="200"
				HorizontalAlignment="Right"
				VerticalAlignment="Top"
				CornerRadius="14"
				Background="#181818"
				BorderBrush="#2D2D2D"
				BorderThickness="1"
				Padding="8"
				BoxShadow="0 8 24 0 #80000000"
				ZIndex="20">

			<StackPanel Spacing="4">

				<Button x:Name="AccountBtn"
						Content="Account"
						Classes="dropdown-item"
						Click="Account_Click"/>

				<Button Content="Token"
						Classes="dropdown-item"
						Click="Token_Click"/>

				<Separator Height="1" Background="#2D2D2D" Margin="4,4"/>

				<Button x:Name="LogoutBtn"
						Content="Logout"
						Classes="dropdown-logout"
						Click="Logout_Click"/>

			</StackPanel>
		</Border>

	</Grid>

	<!-- STYLES -->
	<UserControl.Styles>
		<Style Selector="Button.dropdown-item">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="#E0E0E0"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="Padding" Value="12,10"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
		</Style>
		<Style Selector="Button.dropdown-item:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#252525"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>

		<Style Selector="Button.dropdown-logout">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Padding" Value="12,10"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
		</Style>
		<Style Selector="Button.dropdown-logout:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#321A1A"/>
			<Setter Property="Foreground" Value="white"/>
		</Style>

		<Style Selector="Border.user-card:pointerover">
			<Setter Property="Background" Value="#323232"/>
			<Setter Property="BorderBrush" Value="#4A4A4A"/>
		</Style>

		<Style Selector="Border.bell-btn:pointerover">
			<Setter Property="Background" Value="#323232"/>
			<Setter Property="BorderBrush" Value="#4A4A4A"/>
		</Style>
	</UserControl.Styles>

</UserControl>
