<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="800"
             x:Class="ADIapp.Views.TicketView">

    <Grid>
        <!-- Main View: Split Master/Detail -->
        <Grid x:Name="MainContainer" ColumnDefinitions="320,*" Margin="16">
            <!-- Left Side: Ticket List -->
            <Border Grid.Column="0"
                    Background="#181818"
                    BorderBrush="#2D2D2D"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,16,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- List Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <TextBlock x:Name="SupportTicketsHeaderBlock"
                                   Text="Support Tickets"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="NewTicketButton"
                                Grid.Column="1"
                                Content="+ New Ticket"
                                Background="#3A86FF"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="12"
                                CornerRadius="6"
                                Padding="10,6"
                                Click="NewTicketButton_Click"/>
                    </Grid>

                    <!-- Tickets Scroll List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TicketListPanel" Spacing="8"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Side: Ticket Conversation Thread -->
            <Border Grid.Column="1"
                    Background="#181818"
                    BorderBrush="#2D2D2D"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Ticket Header Details -->
                    <Grid Grid.Row="0" x:Name="TicketHeaderPanel" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="TicketNumberBadge" Background="#333333" CornerRadius="4" Padding="6,2">
                                    <TextBlock x:Name="TicketNumberText" Text="#TK-0000" FontSize="11" FontWeight="Bold" Foreground="#80D8FF"/>
                                </Border>
                                <Border x:Name="TicketStatusBadge" Background="#2E7D32" CornerRadius="4" Padding="6,2">
                                    <TextBlock x:Name="TicketStatusText" Text="OPEN" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TicketSubjectText" Text="Select a ticket to view conversation"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </StackPanel>
                    </Grid>

                    <!-- Thread Messages Container -->
                    <ScrollViewer Grid.Row="1" x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto" Margin="0,8">
                        <StackPanel x:Name="MessagesPanel" Spacing="10"/>
                    </ScrollViewer>

                    <!-- Reply Input Panel -->
                    <Grid Grid.Row="2" x:Name="ReplyPanel" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <TextBox x:Name="ReplyInput"
                                 Grid.Column="0"
                                 Watermark="Type your reply..."
                                 Height="44"
                                 CornerRadius="8"
                                 Background="#252525"
                                 Foreground="White"
                                 BorderBrush="#3D3D3D"
                                 Padding="12,10"
                                 Margin="0,0,12,0"/>
                        <Button x:Name="SendReplyButton"
                                Grid.Column="1"
                                Content="Send Reply"
                                Height="44"
                                Padding="20,0"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Background="White"
                                Foreground="Black"
                                FontWeight="Bold"
                                CornerRadius="8"
                                Click="SendReplyButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay Modal for Creating New Ticket -->
        <Grid x:Name="NewTicketOverlay" Background="#B0000000" IsVisible="False">
            <Border Width="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#1E1E1E" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="12" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="NewTicketModalTitleBlock" Text="Create New Support Ticket" FontSize="20" FontWeight="Bold" Foreground="White"/>

                    <StackPanel Spacing="6">
                        <TextBlock x:Name="SubjectLabelBlock" Text="Subject / Title" FontSize="12" Foreground="#AAAAAA"/>
                        <TextBox x:Name="NewSubjectInput" Watermark="e.g. ECU support, payment inquiry..." Height="40" Background="#2B2B2B" Foreground="White"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ContentLabelBlock" Text="Message Content" FontSize="12" Foreground="#AAAAAA"/>
                        <TextBox x:Name="NewContentInput" Watermark="Describe your issue in detail..." Height="120" AcceptsReturn="True" TextWrapping="Wrap" Background="#2B2B2B" Foreground="White"/>
                    </StackPanel>

                    <TextBlock x:Name="TicketModalErrorText" Foreground="#FF5252" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,8,0,0">
                        <Button x:Name="CancelNewTicketButton" Content="Cancel" Click="CancelNewTicket_Click" Background="#333333" Foreground="White" CornerRadius="6" Padding="16,8"/>
                        <Button x:Name="SubmitNewTicketButton" Content="Submit Ticket" Click="SubmitNewTicket_Click" Background="#3A86FF" Foreground="White" FontWeight="Bold" CornerRadius="6" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
