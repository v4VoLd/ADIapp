<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="800"
             x:Class="ADIapp.Views.AccountView">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MinHeight="600" Margin="32,40">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="640"
                        Spacing="28">

                <!-- TITLE HEADER -->
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock x:Name="AccountTitleBlock"
                               Text="Account Profile"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="AccountSubtitleBlock"
                               Text="Manage your personal information and contact details"
                               FontSize="13"
                               Foreground="#A0A0B0"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- CARD CONTAINER -->
                <Border Background="#181818"
                        BorderBrush="#2D2D2D"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="36,32">
                    <StackPanel Spacing="24">



                        <TextBlock x:Name="HelloUserBlock"
                                   Text="Hello, John Doe."
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#CFCFCF"
                                   HorizontalAlignment="Center"/>

                        <!-- FORM GRID -->
                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="20"
                              RowSpacing="20"
                              Margin="0,8,0,0">

                            <!-- FIRST NAME -->
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="FirstNameLabelBlock"
                                           Text="First name"
                                           FontSize="13"
                                           Foreground="#E0E0E0"
                                           FontWeight="SemiBold"/>
                                <TextBox x:Name="FirstNameBox"
                                         Text="ADI performance"
                                         Background="#252525"
                                         Foreground="White"
                                         BorderBrush="#3D3D3D"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         Height="42"
                                         Padding="12,10"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- LAST NAME -->
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock x:Name="LastNameLabelBlock"
                                           Text="Last name"
                                           FontSize="13"
                                           Foreground="#E0E0E0"
                                           FontWeight="SemiBold"/>
                                <TextBox x:Name="LastNameBox"
                                         Text="Mohamed"
                                         Background="#252525"
                                         Foreground="White"
                                         BorderBrush="#3D3D3D"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         Height="42"
                                         Padding="12,10"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- EMAIL -->
                            <StackPanel Grid.Row="1" Spacing="8">
                                <TextBlock x:Name="EmailLabelBlock"
                                           Text="Email address"
                                           FontSize="13"
                                           Foreground="#E0E0E0"
                                           FontWeight="SemiBold"/>
                                <TextBox x:Name="EmailBox"
                                         Text="email@domain.com"
                                         Background="#252525"
                                         Foreground="#A0A0B0"
                                         BorderBrush="#3D3D3D"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         Height="42"
                                         Padding="12,10"
                                         VerticalContentAlignment="Center"
                                         IsReadOnly="True"/>
                            </StackPanel>

                            <!-- PHONE -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
                                <TextBlock x:Name="PhoneLabelBlock"
                                           Text="Phone number"
                                           FontSize="13"
                                           Foreground="#E0E0E0"
                                           FontWeight="SemiBold"/>
                                <TextBox x:Name="PhoneBox"
                                         Text="123456789"
                                         Background="#252525"
                                         Foreground="White"
                                         BorderBrush="#3D3D3D"
                                         BorderThickness="1"
                                         CornerRadius="8"
                                         Height="42"
                                         Padding="12,10"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- SAVE BUTTON -->
                        <Button Classes="btn-save"
                                MinWidth="180"
                                Height="46"
                                Padding="24,0"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="💾" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SaveBtnTextBlock" Text="Save Changes" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>

    <!-- STYLES -->
    <UserControl.Styles>
        <Style Selector="Button.btn-save">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#141414"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.btn-save:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#141414"/>
        </Style>
    </UserControl.Styles>

</UserControl>
