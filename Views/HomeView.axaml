<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="800"
             x:Class="ADIapp.Views.HomeView">

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="60,50,60,60" Spacing="40" MaxWidth="1100" HorizontalAlignment="Stretch">

			<!-- HERO HEADER SECTION -->
			<Border Background="Transparent"
					Padding="0,20">

				<Grid ColumnDefinitions="*,Auto">
					<StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Left">
						<!-- Badge Tag -->
						<Border Background="Transparent"
								CornerRadius="12"
								Padding="0,6"
								HorizontalAlignment="Left">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<TextBlock Text="⚡" FontSize="14" VerticalAlignment="Center"/>
								<TextBlock Text="ADI PERFORMANCE PLATFORM"
										   FontSize="11"
										   FontWeight="Bold"
										   Foreground="#CFCFCF"/>
							</StackPanel>
						</Border>

						<!-- Title & Description -->
						<TextBlock x:Name="WelcomeTitleText"
								   Text="Welcome to ADI Performance"
								   FontSize="44"
								   FontWeight="Heavy"
								   Foreground="White"
								   HorizontalAlignment="Left"
								   TextWrapping="Wrap"/>

						<TextBlock x:Name="WelcomeDescText"
								   Text="Next-generation ECU tuning, file service management, and automotive performance diagnostics."
								   FontSize="16"
								   Foreground="#A0A0B0"
								   HorizontalAlignment="Left"
								   TextWrapping="Wrap"
								   MaxWidth="650"/>

						<!-- Action Buttons -->
						<StackPanel Orientation="Horizontal" Spacing="16" Margin="0,12,0,0" HorizontalAlignment="Left">
							<Button x:Name="GetStartedBtn"
									Content="Get Started ➔"
									Click="GetStarted_Click"
									Classes="hero-primary"/>

							<Button x:Name="LearnMoreBtn"
									Content="Learn More"
									Click="Info_Click"
									Classes="hero-secondary"/>
						</StackPanel>
					</StackPanel>

				</Grid>
			</Border>
		</StackPanel>
	</ScrollViewer>

	<!-- STYLES -->
	<UserControl.Styles>

		<!-- Hero Primary Button -->
		<Style Selector="Button.hero-primary">
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="#141414"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="Padding" Value="24,12"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.hero-primary:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#E0E0E0"/>
			<Setter Property="Foreground" Value="#141414"/>
		</Style>

		<!-- Hero Secondary Button -->
		<Style Selector="Button.hero-secondary">
			<Setter Property="Background" Value="#141414"/>
			<Setter Property="Foreground" Value="white"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="Padding" Value="22,12"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.hero-secondary:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#323242"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>




	</UserControl.Styles>

</UserControl>
