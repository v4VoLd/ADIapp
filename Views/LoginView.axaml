<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="800"
             x:Class="ADIapp.Views.LoginView">

    <Grid Background="Black">

        <!-- Background -->
        <Image Source="avares://ADIapp/Assets/login_background.png"
               Stretch="UniformToFill"/>

        <!-- Centered Login Card -->
        <Border Width="440"
                Padding="36,32"
                Background="#141414"
                BorderThickness="0"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 16 48 0 #B0000000">

            <StackPanel Spacing="18">

                <!-- Logo Header -->
                <Image Source="avares://ADIapp/Assets/login_logo.png"
                       Width="260"
                       Height="75"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,2"/>

                <!-- Subtitle Description -->
                <TextBlock x:Name="WelcomeSubtitleText"
                           Text="Sign in to access your ADI Performance account"
                           FontSize="13"
                           Foreground="#9E9EA0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,6"/>

                <!-- USERNAME / EMAIL INPUT -->
                <StackPanel Spacing="6" Margin="0,8,0,0">
                    <TextBlock x:Name="UsernameLabelText"
                               Text="Username or Email"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#CFCFCF"/>

                    <TextBox x:Name="EmailBox"
                             FontSize="14"
                             Padding="14,12"
                             Foreground="White"
                             Background="#1c1c1c"
                             BorderBrush="#393939"
                             BorderThickness="1"
                             CornerRadius="10"
                             Watermark="Enter Your Email"/
                </StackPanel>

                <!-- PASSWORD INPUT -->
                <StackPanel Spacing="6">
                    <TextBlock x:Name="PasswordLabelText"
                               Text="Password"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#CFCFCF"/>

                    <TextBox x:Name="PasswordBox"
                             FontSize="14"
                             Padding="14,12"
                             Foreground="White"
                             Background="#1c1c1c"
                             BorderBrush="#393939"
                             BorderThickness="1"
                             CornerRadius="10"
                             PasswordChar="•"
                             Watermark="Enter password"/>
                </StackPanel>

                <!-- ERROR MESSAGE -->
                <TextBlock x:Name="ErrorLabel"
                           Foreground="#FF4D4D"
                           FontSize="13"
                           FontWeight="Medium"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           IsVisible="False"/>

                <!-- SUBMIT BUTTON -->
                <Button x:Name="LoginButton"
                        Content="Sign In ➔"
                        FontSize="15"
                        FontWeight="Bold"
                        Background="White"
                        Foreground="#141414"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Height="46"
                        CornerRadius="10"
                        Margin="0,8,0,0"
                        Cursor="Hand"
                        Click="Login_Click"
                        IsDefault="True"
                        Classes="login-btn"/>

                <!-- SIGN UP LINK -->
                <Button x:Name="SignUpButton"
                        Content="Don't have an account? Sign Up"
                        FontSize="13"
                        FontWeight="Normal"
                        Foreground="#9E9EA0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Center"
                        Margin="0,4,0,0"
                        Cursor="Hand"
                        Click="SignUp_Click"
                        Classes="signup-btn"/>

            </StackPanel>

        </Border>

        <!-- STYLES -->
        <Grid.Styles>
            <Style Selector="Button.login-btn:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#E0E0E0"/>
                <Setter Property="Foreground" Value="#141414"/>
            </Style>
            <Style Selector="Button.signup-btn:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#3B82F6"/>
            </Style>
            <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                <Setter Property="BorderBrush" Value="#3B82F6"/>
                <Setter Property="Background" Value="#1C1C24"/>
            </Style>
        </Grid.Styles>

    </Grid>
</UserControl>
